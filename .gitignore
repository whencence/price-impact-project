cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environments
.env
.venv/
venv/
env/
*.egg-info/

# Data
data/
*.csv
*.parquet
*.feather
*.h5
*.hdf5

# Large/generated outputs
outputs/full_runs/
outputs/night_logs/
outputs/**/*.csv
outputs/**/*.parquet
outputs/**/*.pkl
outputs/**/*.npy
outputs/**/*.npz

# Keep final lightweight artifacts if needed
!outputs/final_keep/
!outputs/final_keep/**

# OS / IDE
.DS_Store
.vscode/
.idea/
EOF